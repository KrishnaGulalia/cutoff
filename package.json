{
  "name": "cutoff",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.js",
    "data:validate": "node scripts/validate-paper.js",
    "data:import": "node scripts/import-paper.js",
    "seed:demo": "node scripts/import-paper.js data/demo-paper.json",
    "check:env": "node scripts/check-env.js",
    "format": "prettier --write src client/src scripts tests docs README.md package.json client/package.json playwright.config.js client/vite.config.js",
    "format:check": "prettier --check src client/src scripts tests docs README.md package.json client/package.json playwright.config.js client/vite.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Cutoff JEE practice app",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
