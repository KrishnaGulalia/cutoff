{
  "name": "cutoff",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "db:migrate": "node scripts/migrate.js",
    "data:validate": "node scripts/validate-paper.js",
    "data:import": "node scripts/import-paper.js",
    "check:env": "node scripts/check-env.js",
    "format": "prettier --write src client/src scripts docs README.md package.json client/package.json client/vite.config.js",
    "format:check": "prettier --check src client/src scripts docs README.md package.json client/package.json client/vite.config.js",
    "postinstall": "prisma generate",
    "papers:import": "node scripts/import-paper.js data/2026-session-2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Cutoff JEE practice app",
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "^2.119.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "prisma": "6.19.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
